    "ai.enableHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Apple Intelligence or add an OpenAI key in Settings"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence'ı aç ya da Ayarlar'a bir OpenAI anahtarı ekle"
          }
