    "alert.meeting.close" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapat"
          }
        }
      }
    },
    "alert.meeting.cloudOff.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meetings are transcribed in the cloud. Turn on cloud transcription and add your API key in Settings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplantılar bulutta metne dönüştürülür. Ayarlar'da bulut transkripsiyonunu aç ve API anahtarını ekle."
          }
        }
      }
    },
    "alert.meeting.couldNotSaveNotes.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The meeting was recorded but its notes could not be written to disk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplantı kaydedildi ancak notları diske yazılamadı."
          }
        }
      }
    },
    "alert.meeting.couldNotStart.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording could not be started. Check that another app is not already capturing audio, then try again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt başlatılamadı. Başka bir uygulamanın ses kaydetmediğinden emin ol ve yeniden dene."
