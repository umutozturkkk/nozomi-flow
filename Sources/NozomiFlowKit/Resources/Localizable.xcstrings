    "alert.meeting.screenRecordingDenied.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nozomi Flow needs Screen Recording permission to hear the other side of the call. No screen images are captured or kept. Quit and reopen the app after granting it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nozomi Flow'un görüşmenin karşı tarafını duyabilmesi için Ekran Kaydı iznine ihtiyacı var. Hiçbir ekran görüntüsü alınmaz ya da saklanmaz. İzni verdikten sonra uygulamadan çıkıp yeniden aç."
          }
        }
      }
    },
