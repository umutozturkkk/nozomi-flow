    "onboarding.screenRecording.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To capture the other side of a call, macOS routes system audio through Screen Recording. Nothing on your screen is read or kept: the video side of that stream is two pixels wide and thrown away."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüşmedeki diğer tarafı kaydetmek için macOS sistem sesini Ekran Kaydı üzerinden iletir. Ekranındaki hiçbir şey okunmaz ya da saklanmaz: bu akışın görüntü tarafı iki piksel genişliğindedir ve atılır."
          }
        }
      }
    },
